<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client_For_Messenger.RegisterPage"
             Title="RegisterPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" VerticalOptions="Center"
                             MaximumWidthRequest="400" HorizontalOptions="Center">

            <Label Text="Create Account" FontSize="28" FontAttributes="Bold" 
                   HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="Email" Margin="5,0" FontSize="12" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="EmailTb" Placeholder="your@email.com" Keyboard="Email"/>
            </Border>

            <Label Text="Username" Margin="5,0" FontSize="12" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="UsernameTb" Placeholder="Display name"/>
            </Border>

            <Label Text="Password" Margin="5,0" FontSize="12" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="PasswordTb" IsPassword="True" Placeholder="••••••••"/>
            </Border>

            <Label Text="Confirm Password" Margin="5,0" FontSize="12" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="PasswordConfirmTb" IsPassword="True" Placeholder="••••••••"/>
            </Border>

            <Button Text="Sign Up" Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnSendClicked" IsEnabled="{Binding ActiveBtn}" Margin="0,10,0,0"/>

            <Label Text="{Binding Error}" TextColor="#E74C3C" HorizontalOptions="Center"
                   x:Name="StatusLabel"
                   IsVisible="{Binding VisibleError}" FontSize="13"/>

            <Button Text="Already have an account? Login" Style="{StaticResource LinkButtonStyle}"
                    Clicked="OpenLoginPage"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>