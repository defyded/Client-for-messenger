<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client_For_Messenger.LoginPage"
             >

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center"
                             MaximumWidthRequest="400" HorizontalOptions="Center">

            <Label Text="Welcome Back" FontSize="28" FontAttributes="Bold" 
                   HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="Email" Margin="5,0" FontSize="13" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="LoginTb" Placeholder="example@mail.com" Keyboard="Email"/>
            </Border>

            <Label Text="Password" Margin="5,0" FontSize="13" Opacity="0.8"/>
            <Border Style="{StaticResource InputBorderStyle}">
                <Entry x:Name="PasswordTb" IsPassword="True" Placeholder="••••••••"/>
            </Border>

            <Button Text="Login" Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnSendClicked" IsEnabled="{Binding ActiveBtn}" Margin="0,10,0,0"/>

            <Label Text="{Binding Error}" TextColor="#E74C3C" HorizontalOptions="Center"
                   x:Name="StatusLabel"
                   IsVisible="{Binding VisibleError}" FontSize="13"/>

            <Button Text="Don't have an account? Register" Style="{StaticResource LinkButtonStyle}"
                    Clicked="OpenRegisterPage"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
